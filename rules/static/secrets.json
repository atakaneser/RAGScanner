{
  "schema_version": "1.0.0",
  "version": "1.0.0",
  "pack_id": "static.secrets",
  "description": "Likely credentials and private key material with mandatory evidence masking.",
  "rules": [
    {
      "id": "STATIC-SEC-001",
      "version": "1.0.0",
      "name": "Likely secret or credential exposure",
      "category": "secret_exposure",
      "description": "Content contains a likely credential, token, private key, or connection string.",
      "severity": "critical",
      "default_confidence": 0.96,
      "detection_type": "deterministic",
      "scope": [
        "raw_document",
        "metadata",
        "chunk"
      ],
      "matchers": [
        {
          "type": "secret_pattern",
          "patterns": [],
          "flags": [],
          "metadata_fields": [],
          "minimum_length": 8,
          "metadata": {}
        }
      ],
      "exclusions": [],
      "context_requirements": [
        "not_placeholder"
      ],
      "evidence_window": 100,
      "remediation": "Remove and rotate exposed credentials; use secure secret references instead.",
      "references": [
        "OWASP-LLM02"
      ],
      "enabled": true,
      "tags": [
        "secret",
        "credential"
      ],
      "languages": [
        "*"
      ],
      "metadata": {
        "impact": "Credentials in a knowledge source may be retrieved or disclosed."
      }
    }
  ]
}
