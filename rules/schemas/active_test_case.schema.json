{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ragscanner://schemas/active-test-case/1.0.0",
  "title": "RAGScanner active security rule pack",
  "type": "object",
  "required": ["schema_version", "pack_id", "version", "description", "test_cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pack_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 1},
    "test_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test_case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["id", "content", "language", "encoding", "tags", "safe_for_production", "expected_behavior", "placeholders", "metadata"]
    },
    "test_case": {
      "type": "object",
      "required": ["id", "name", "category", "description", "severity", "detection_type", "default_safety_mode", "side_effect_risk", "requires_tool_access", "requires_retrieval", "languages", "tags", "payloads", "control_payload", "expected_safe_behavior", "unsafe_indicators", "safe_indicators", "ambiguous_indicators", "remediation", "references", "enabled", "version", "metadata"]
    }
  }
}
